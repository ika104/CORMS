eaterOrEquals(length(string(item()?['raw'])), 20), equals(substring(concat(string(item()?['raw']), '..........'), 10, 1), 'T'), endsWith(string(item()?['raw']), 'Z'))), equals(substring(concat(string(item()?['raw']), '..........'), 4, 1), '-'), equals(substring(concat(string(item()?['raw']), '..........'), 7, 1), '-'), isInt(substring(concat(string(item()?['raw']), '..........'), 0, 4)), isInt(substring(concat(string(item()?['raw']), '..........'), 5, 2)), isInt(substring(concat(string(item()?['raw']), '..........'), 8, 2))), string(item()?['raw']), '2000-01-01T00:00:00Z'), 'Arabian Standard Time', 'dd/MM/yyyy')), string(item()?['raw'])))))))"
