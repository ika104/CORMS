              "error": "@{if(equals(actions('Build_payload')?['status'], 'Failed'), 'DocumentUnreadable: the main document could not be read from SharePoint.', if(equals(actions('Save_signed_as_main')?['status'], 'Failed'), 'SaveFailed: the signed document could not be saved to SharePoint.', if(not(empty(coalesce(body('Parse_result')?['error'], ''))), body('Parse_result')?['error'], if(not(equals(actions('Call_signing_flow')?['status'], 'Succeeded')), concat('ProviderUnavailable: the signing flow answered ', string(coalesce(outputs('Call_signing_flow')?['statusCode'], 0)), '.'), if(and(equals(triggerBody()?['text_1'], 'GetSignedDocument'), empty(coalesce(body('Parse_result')?['contentBase64'], ''))), 'NoSignedDocument: the signing service returned no signed document.', '')))))}",
