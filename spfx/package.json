    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@pnp/sp": "^4.20.0",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "dynamsoft-document-scanner": "^1.5.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
